{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://binnagent.local/contracts/grammar-ontology/v1/grammar-catalog.schema.json",
  "title": "BinnAgent Grammar Construction Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalog_id", "version", "constructions"],
  "properties": {
    "catalog_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]+$"},
    "version": {"type": "integer", "minimum": 1},
    "constructions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/construction"}
    }
  },
  "$defs": {
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation_type", "target_id"],
      "properties": {
        "relation_type": {
          "enum": [
            "IS_A",
            "REQUIRES",
            "VARIANT_OF",
            "CONTRASTS_WITH",
            "COMMONLY_CONFUSED_WITH",
            "REALIZES_FUNCTION",
            "SUPPORTS_EXAM_SKILL"
          ]
        },
        "target_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.]+\\.v[1-9][0-9]*$"}
      }
    },
    "construction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "construction_id",
        "version",
        "title_zh",
        "family",
        "form",
        "meaning",
        "use",
        "constraints",
        "aliases",
        "relations",
        "parser_signatures",
        "can_do_outcomes",
        "external_mappings"
      ],
      "properties": {
        "construction_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.]+\\.v[1-9][0-9]*$"
        },
        "version": {"type": "integer", "minimum": 1},
        "title_zh": {"type": "string", "minLength": 2},
        "family": {"type": "string", "minLength": 2},
        "form": {"type": "string", "minLength": 3},
        "meaning": {"type": "string", "minLength": 3},
        "use": {"type": "string", "minLength": 3},
        "constraints": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "aliases": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "relations": {"type": "array", "items": {"$ref": "#/$defs/relation"}},
        "parser_signatures": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "can_do_outcomes": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "external_mappings": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
